# Lumi V4 RC1 local configuration example.
# Copy to a local shell/environment manager. Never commit real secrets.

LUMI_DATA_DIR=.lumi-data
LUMI_DATABASE_PATH=.lumi-data/lumi.sqlite3

# Keep empty for loopback-only local use. For any remote/LAN access, configure a strong key.
# The macOS client reads the same LUMI_API_KEY environment variable.
LUMI_API_KEY=
LUMI_API_DOCS=false
LUMI_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
LUMI_CORS_ORIGINS=

LUMI_BACKUP_BEFORE_MIGRATE=true
LUMI_BACKUP_DIR=.lumi-data/backups
LUMI_BACKUP_KEEP=10

LUMI_OLLAMA_URL=http://127.0.0.1:11434/api/chat
LUMI_OLLAMA_MODEL=llama3.2
LUMI_OLLAMA_EMBED_URL=http://127.0.0.1:11434/api/embed
LUMI_EMBEDDING_MODEL=embeddinggemma
LUMI_RAG_DENSE=true

LUMI_CONTEXT_MAX_INPUT_TOKENS=6000
LUMI_CONTEXT_RECENT_TOKENS=3500
LUMI_CONTEXT_SUMMARY_TOKENS=800
LUMI_MEMORY_RECALL_K=4

LUMI_TOOL_WORKSPACE=.lumi-data/workspace

# Developer Agent remains disabled until a separate checkout is configured.
LUMI_DEV_REPO_ROOT=
LUMI_DEV_BASE_BRANCH=main
LUMI_DEV_ALLOW_LOCAL_CHECKS=false
LUMI_DEV_GITHUB_REPOSITORY=
LUMI_DEV_GITHUB_TOKEN=
